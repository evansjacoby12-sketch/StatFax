{
  "name": "statfax-brain",
  "private": true,
  "type": "module",
  "description": "StatFax MLB home-run probability engine + data pipeline — the headless 'brain' behind statfax.online.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "serve": "node server/serve.mjs",
    "doctor": "node server/doctor.mjs",
    "doctor:json": "node server/doctor.mjs --json",
    "build-model": "node server/build-model.mjs",
    "slate": "node server/fetch-slate.mjs",
    "validate:mlb-data": "node server/tools/validate-mlb-data.mjs",
    "validate:mlb-game-results": "node server/tools/validate-mlb-game-results.mjs",
    "validate:mlb-game-history": "node server/tools/validate-mlb-game-history.mjs",
    "audit:mlb-game-distribution": "node server/tools/audit-game-score-distribution.mjs",
    "mlb:data-health": "node server/mlb-data-health.mjs",
    "validate:mlb-data-health": "node server/tools/validate-mlb-data-health.mjs",
    "mlb:archive": "node server/mlb-operations.mjs archive",
    "mlb:rollback": "node server/mlb-operations.mjs rollback",
    "mlb:recover": "node server/mlb-operations.mjs recover",
    "mlb:audit": "node server/mlb-operations.mjs audit",
    "mlb:zone-evaluate": "node server/zone-evaluate.mjs",
    "validate:zone-evaluation": "node server/tools/validate-zone-evaluation.mjs",
    "mlb:list-builder-evidence": "node server/list-builder-evidence.mjs",
    "mlb:feature-coverage": "node server/tools/report-historical-feature-coverage.mjs",
    "mlb:browser-history": "node server/build-browser-history.mjs",
    "validate:list-builder-evidence": "node server/tools/validate-list-builder-evidence.mjs",
    "brief": "node server/slate-brief.mjs",
    "reconcile": "node server/reconcile.mjs",
    "nfl:history": "python server/sports/nfl/build-history.py --from-season 2020",
    "nfl:history:quick": "python server/sports/nfl/build-history.py --from-season 2020 --skip-pbp",
    "nfl:slate": "node server/sports/nfl/fetch-nfl-slate.mjs",
    "nfl:week1": "node server/sports/nfl/fetch-nfl-slate.mjs --season-type regular-season --week 1",
    "nfl:backtest": "node server/sports/nfl/backtest.mjs",
    "nfl:audit": "node server/sports/nfl/operations.mjs audit",
    "nfl:archive": "node server/sports/nfl/operations.mjs archive",
    "nfl:rollback": "node server/sports/nfl/operations.mjs rollback",
    "nfl:recover": "node server/sports/nfl/operations.mjs recover",
    "nfl:rehearse": "node server/sports/nfl/rehearsal.mjs",
    "lab:pull": "node model-lab/pull-data.mjs",
    "lab:backtest": "node model-lab/backtest.mjs",
    "lab:train": "node model-lab/train-logreg.mjs",
    "lab:score": "node model-lab/score-offline.mjs",
    "lab:audit": "node model-lab/badge-audit.mjs",
    "lab:blast": "node model-lab/blast-audit.mjs",
    "lab:blast-model": "node model-lab/blast-model.mjs",
    "lab:board": "node model-lab/board-evolution.mjs",
    "lab:k": "node model-lab/k-prop-audit.mjs",
    "lab:matchup": "node model-lab/matchup-model.mjs",
    "lab:validate-ceil": "node model-lab/validate-ceil.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
