# Local-only StatFax environment template. Copy to .env if a command needs it.
# Never commit real values. GitHub Actions and Cloudflare Worker secrets are set
# in their dashboards/CLIs; this file documents names only.

# Optional paid/current-data inputs
ODDS_API_KEY=
OPENAI_API_KEY=

# Build-time quick site lock (SHA-256 hash only; never put the plaintext password here)
VITE_SITE_PASSWORD_HASH=

# Durable public artifact recovery
MLB_R2_PUBLIC_BASE_URL=https://pub-f7f0c61cfc5840ce8b07ddb42902aa48.r2.dev
MLB_R2_ARCHIVE_DATE=
NFL_R2_PUBLIC_BASE_URL=https://pub-f7f0c61cfc5840ce8b07ddb42902aa48.r2.dev

# Local runtime
PORT=5180
REFRESH_MINUTES=20
MORNING_LOCK=false
MORNING_LOCK_HOUR=10

# Optional model/runtime overrides; defaults are normally preferred
BRIEF_MODEL=gpt-5.6-luna
BRIEF_STALE_HOURS=4
ODDS_REFRESH_MINUTES=30

# Operational doctor overrides
DOCTOR_SITE_URL=https://statfax.online
DOCTOR_R2_URL=https://pub-f7f0c61cfc5840ce8b07ddb42902aa48.r2.dev
DOCTOR_WORKER_URL=https://statfax-cron.evansjacoby12.workers.dev
DOCTOR_GITHUB_REPO=evansjacoby12-sketch/StatFax
DOCTOR_MAX_SLATE_AGE_MINUTES=50
